{
  "name": "repropack",
  "version": "0.2.0",
  "description": "Browser extension that turns broken pages into clean, filed bug reports. Organizes evidence \u2014 never invents a cause.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate.js",
    "build:firefox": "node scripts/build-firefox.js",
    "check": "npm run validate && npm test",
    "demo": "node scripts/serve.js"
  },
  "keywords": [
    "bug-report",
    "browser-extension",
    "manifest-v3",
    "har",
    "jira",
    "github",
    "slack"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}
