{
  "manifest_version": 3,
  "name": "ReproPack — Bug Report Capture",
  "short_name": "ReproPack",
  "version": "0.2.0",
  "description": "Capture a screenshot, timeline, console errors and requests, then file a clean bug report to GitHub, Jira or Slack.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "tabCapture", "offscreen", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReproPack — Capture bug report",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Open ReproPack to capture a bug report"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
